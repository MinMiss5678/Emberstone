{
  "test_globs": [
    "crates/*/tests/**/*.rs",
    "crates/*/src/**/tests.rs",
    "crates/*/src/**/tests/**/*.rs",
    "tools/*/tests/**"
  ],
  "impl_globs": [
    "crates/*/src/**/*.rs",
    "crates/*/build.rs",
    "tools/*/src/**/*.rs",
    "tools/rosetta-bridge/**/*.cpp",
    "tools/rosetta-bridge/**/*.hpp",
    "tools/rosetta-bridge/patches/**",
    "tools/rosetta-bridge/build.bat",
    "data/*.txt",
    "data/*.tsv"
  ],
  "ignore_globs": [
    "target/**",
    "tools/rosetta-bridge/build/**",
    "docs/**",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "data/README.md",
    "tools/rosetta-bridge/README.md",
    ".claude/**",
    "**/Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "deny.toml",
    ".github/**",
    ".githooks/**",
    ".gitignore",
    ".gitattributes",
    ".gitleaksignore"
  ],
  "test_command_regex": "(^|[;&|]\\s*)cargo\\s+(\\+\\S+\\s+)?test\\b",
  "language": "rust",
  "mcp_server": "rustrover",
  "code_extensions": [
    ".rs",
    ".cpp",
    ".hpp"
  ],
  "migration_command_regex": "(^|[;&|]\\s*)cargo\\s+run\\b.*(-p\\s+emberstone-(data|cardgen)\\b|-p\\s+emberstone-difftest\\b.*\\b(batches|keywords)\\b)",
  "migration_globs": [
    "crates/emberstone-data/src/generated/**",
    "data/batches.tsv",
    "data/keyword_pool.txt"
  ]
}
