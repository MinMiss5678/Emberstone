diff --git a/Sources/Rosetta/PlayMode/Tasks/SimpleTasks/IncludeTask.cpp b/Sources/Rosetta/PlayMode/Tasks/SimpleTasks/IncludeTask.cpp
--- a/Sources/Rosetta/PlayMode/Tasks/SimpleTasks/IncludeTask.cpp
+++ b/Sources/Rosetta/PlayMode/Tasks/SimpleTasks/IncludeTask.cpp
@@ -392,6 +392,18 @@ std::vector<Playable*> IncludeTask::GetEntities(EntityType entityType,
                 "IncludeTask::GetEntities() - Invalid entity type");
     }
 
+    // Dormant minions are not affected by group or random effects
+    using enum EntityType;
+    if (entityType != SOURCE && entityType != TARGET && entityType != STACK &&
+        entityType != STACK_NUM0 && entityType != EVENT_SOURCE &&
+        entityType != EVENT_TARGET)
+    {
+        std::erase_if(entities, [](Playable* playable) {
+            const auto minion = dynamic_cast<Minion*>(playable);
+            return minion && minion->IsUntouchable();
+        });
+    }
+
     return entities;
 }
 
