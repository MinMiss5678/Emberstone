Make The Coin follow the current Hearthstone rules:
- RosettaStone 1690208 has no power for GAME_005, so playing The Coin does
  nothing. Give it the same power as Innervate (1 temporary mana).
- Since patch 29.0 (2024-03), temporary mana can take available mana above 10
  (e.g. 11/10). RosettaStone still caps it at MANA_UPPER_LIMIT.

diff --git a/Sources/Rosetta/PlayMode/CardSets/LegacyCardsGen.cpp b/Sources/Rosetta/PlayMode/CardSets/LegacyCardsGen.cpp
--- a/Sources/Rosetta/PlayMode/CardSets/LegacyCardsGen.cpp
+++ b/Sources/Rosetta/PlayMode/CardSets/LegacyCardsGen.cpp
@@ -593,6 +593,15 @@
     cardDef.ClearData();
     cardDef.power.AddPowerTask(std::make_shared<TempManaTask>(1));
     cards.emplace("EX1_169", cardDef);
+
+    // ---------------------------------------- SPELL - NEUTRAL
+    // [GAME_005] The Coin - COST:0
+    // --------------------------------------------------------
+    // Text: Gain 1 Mana Crystal this turn only.
+    // --------------------------------------------------------
+    cardDef.ClearData();
+    cardDef.power.AddPowerTask(std::make_shared<TempManaTask>(1));
+    cards.emplace("GAME_005", cardDef);
 
     // ------------------------------------------ SPELL - DRUID
     // [EX1_173] Starfire - COST:6
diff --git a/Sources/Rosetta/PlayMode/Tasks/SimpleTasks/TempManaTask.cpp b/Sources/Rosetta/PlayMode/Tasks/SimpleTasks/TempManaTask.cpp
--- a/Sources/Rosetta/PlayMode/Tasks/SimpleTasks/TempManaTask.cpp
+++ b/Sources/Rosetta/PlayMode/Tasks/SimpleTasks/TempManaTask.cpp
@@ -16,15 +16,7 @@
 TaskStatus TempManaTask::Impl(Player* player)
 {
-    if (player->GetRemainingMana() + m_amount > MANA_UPPER_LIMIT)
-    {
-        player->SetTemporaryMana(
-            player->GetTemporaryMana() +
-            (MANA_UPPER_LIMIT - player->GetRemainingMana()));
-    }
-    else
-    {
-        player->SetTemporaryMana(player->GetTemporaryMana() + m_amount);
-    }
+    // Since patch 29.0 (2024-03), temporary mana can exceed 10.
+    player->SetTemporaryMana(player->GetTemporaryMana() + m_amount);
 
     return TaskStatus::COMPLETE;
 }
