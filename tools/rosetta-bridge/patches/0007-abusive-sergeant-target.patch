Abusive Sergeant (CORE_CS2_188) can be played without a target when there is
no other minion (user-approved case C2: a battlecry with no valid target is
skipped, the minion is still played). RosettaStone 1690208 uses
REQ_TARGET_TO_PLAY, which makes the card unplayable on an empty board.

diff --git a/Sources/Rosetta/PlayMode/CardSets/CoreCardsGen.cpp b/Sources/Rosetta/PlayMode/CardSets/CoreCardsGen.cpp
--- a/Sources/Rosetta/PlayMode/CardSets/CoreCardsGen.cpp
+++ b/Sources/Rosetta/PlayMode/CardSets/CoreCardsGen.cpp
@@ -3466,6 +3466,6 @@
     cardDef.power.AddPowerTask(
         std::make_shared<AddEnchantmentTask>("CS2_188o", EntityType::TARGET));
-    cardDef.property.playReqs = PlayReqs{ { PlayReq::REQ_TARGET_TO_PLAY, 0 },
+    cardDef.property.playReqs = PlayReqs{ { PlayReq::REQ_TARGET_IF_AVAILABLE, 0 },
                                           { PlayReq::REQ_MINION_TARGET, 0 } };
     cards.emplace("CORE_CS2_188", cardDef);
 
